<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/book_background"
    android:padding="16dp">

    <ImageView
        android:id="@+id/ivBookCover"
        android:layout_width="72dp"
        android:layout_height="100dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:background="@color/book_primary"
        android:contentDescription="Обложка" />

    <TextView
        android:id="@+id/tvDetailTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/ivBookCover"
        android:layout_marginStart="16dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/book_text" />

    <TextView
        android:id="@+id/tvDetailAuthor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvDetailTitle"
        android:layout_alignStart="@id/tvDetailTitle"
        android:textColor="#5C4033"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvDetailPages"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvDetailAuthor"
        android:layout_alignStart="@id/tvDetailAuthor"
        android:textColor="@color/book_text"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvDetailReview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/ivBookCover"
        android:layout_marginTop="24dp"
        android:textSize="16sp"
        android:textColor="@color/book_text" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:text="Назад"
        android:backgroundTint="@color/book_primary"
        android:textColor="#FFFFFF" />

</RelativeLayout>